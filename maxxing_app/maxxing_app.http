@maxxing_app_HostAddress = http://localhost:5055

GET {{maxxing_app_HostAddress}}/health

###

POST {{maxxing_app_HostAddress}}/auth/register
Content-Type: application/json

{
  "email": "test@example.com",
  "userName": "test",
  "password": "sifre1234"
}

###

# @name login
POST {{maxxing_app_HostAddress}}/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "sifre1234"
}

###

GET {{maxxing_app_HostAddress}}/auth/me
Authorization: Bearer {{login.response.body.$.token}}

###

# Kod, Mailpit'e düşen mailde: http://localhost:8025
POST {{maxxing_app_HostAddress}}/auth/verify-email
Authorization: Bearer {{login.response.body.$.token}}
Content-Type: application/json

{
  "code": "123456"
}

###

POST {{maxxing_app_HostAddress}}/auth/verify-email/resend
Authorization: Bearer {{login.response.body.$.token}}

###
