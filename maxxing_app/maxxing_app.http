@maxxing_app_HostAddress = http://localhost:5055

GET {{maxxing_app_HostAddress}}/health

###

POST {{maxxing_app_HostAddress}}/auth/register
Content-Type: application/json

{
  "email": "test@example.com",
  "userName": "test",
